# Live-server test configuration for aiosecurityspy.
#
# Copy to `.env` and fill in. `.env` is gitignored by this repository's own
# .gitignore (not merely the parent's), so it survives the subtree split that
# publishes this directory as a standalone public repo.
#
# Every live test is marked `@pytest.mark.live` and SKIPS when these are unset,
# so CI and any clone without a server run the offline suite unchanged:
#
#     uv run pytest                 # offline only; live tests skip
#     uv run pytest -m live         # live tests, read-only
#     uv run pytest -m live         # + SECURITYSPY_ALLOW_WRITES=1 for mutating

# --- server -------------------------------------------------------------------
SECURITYSPY_HOST=
SECURITYSPY_PORT=8001
SECURITYSPY_USE_HTTPS=1
# 0 if the certificate does not match the address used (the FR-26 case).
SECURITYSPY_VERIFY_SSL=0

# --- accounts -----------------------------------------------------------------
# One per rung of SecuritySpy's "Permission type" ladder. Each answers a
# question no other account can.

# "Live" -- camera visible, every write refused. The DW 1.6a case.
SECURITYSPY_LIVE_USER=
SECURITYSPY_LIVE_PASS=
# Per-account API key (SecuritySpy 6.22b9+) for the same "Live" account.
# aiosecurityspy.tests.test_live_server sends this as the Basic-auth password
# in place of SECURITYSPY_LIVE_PASS for its key-specific tests; USER/PASS stay
# required alongside it because the live-account fixture still needs a
# username and the tests still skip without a full account configured
# (Story 1.21).
SECURITYSPY_LIVE_KEY=

# "Live, Captures" -- separates media access from control.
SECURITYSPY_CAPTURES_USER=
SECURITYSPY_CAPTURES_PASS=

# "Live, Captures, Control" -- does Control include PERM_SCHED (arm/disarm),
# or only PERM_CAMCONTROL (PTZ/trigger)? The library treats them as independent.
SECURITYSPY_CONTROL_USER=
SECURITYSPY_CONTROL_PASS=

# "Administrator" -- baseline; writes must succeed. Settles override=-1 (T10).
SECURITYSPY_ADMIN_USER=
SECURITYSPY_ADMIN_PASS=

# "Per-camera custom permissions" -- validates that the permissions mask really
# does vary per camera within one account, which the library's model assumes.
SECURITYSPY_PERCAM_USER=
SECURITYSPY_PERCAM_PASS=

# Password identical to its own key (edge case) -- an account whose password
# was deliberately set equal to its own API key. SecuritySpy then treats it as
# key-authenticated on every endpoint (any username accepted) and refuses its
# own password at the web UI login. Story 1.21's spike documents this as a
# SecuritySpy-side lock-out, outside library control.
SECURITYSPY_SAMEKEY_USER=
SECURITYSPY_SAMEKEY_PASS=
SECURITYSPY_SAMEKEY_KEY=

# Password shaped like the start of a key but not the full key shape -- Story
# 1.22's closure of the sub-AC Story 1.21 left untested: does a password that
# merely begins `API_` get mistaken for a key? A real key is `API_` followed by
# exactly 32 base62 (A-Za-z0-9) characters, 36 total; this password must start
# with `API_` but NOT match that exactly -- e.g. `API_` + 31 characters, or 32
# characters including at least one that isn't A-Za-z0-9. The test asserts this
# shape itself, so a misconfigured value fails loudly rather than silently
# testing the wrong thing. Optional; the live test that uses it skips cleanly
# when unset.
SECURITYSPY_PARTIALKEY_USER=
SECURITYSPY_PARTIALKEY_PASS=

# Per-account API key for the existing PERCAM account (see SECURITYSPY_PERCAM_
# USER/_PASS above), used to test a camera number outside that account's
# per-camera grants. Optional; the live test that uses it skips cleanly when
# unset.
SECURITYSPY_PERCAM_KEY=

# --- named cameras ------------------------------------------------------------
# Nothing is hardcoded to a particular server; name the cameras here.

# Camera number the mutating write tests may arm/disarm. Its arming state is
# read first and restored afterwards. Pick one whose recording you do not mind
# perturbing.
SECURITYSPY_TEST_CAMERA=

# For SECURITYSPY_PERCAM_USER: two cameras that account sees DIFFERENTLY --
# one with full rights, one with live-only. If the masks come back identical
# the per-camera model is over-engineered, which is itself a finding.
SECURITYSPY_PERCAM_FULL_CAMERA=
SECURITYSPY_PERCAM_LIMITED_CAMERA=

# --- safety -------------------------------------------------------------------
# Unset/0: live tests only ever READ. Set to 1 to allow the tests that actually
# arm and disarm SECURITYSPY_TEST_CAMERA on your real system.
SECURITYSPY_ALLOW_WRITES=0
